# Root & Reason — Environment Configuration Template
# Copy this file to .env.local and fill in real credentials.
# The app is fully functional without any keys (built-in demo fixtures +
# deterministic fallback reporting).
#
# Next.js load order (first match wins):
#   .env.<NODE_ENV>.local > .env.local > .env.<NODE_ENV> > .env
# Do not define the same variable in both .env and .env.local unless you intend
# .env.local to override .env.

# ── Supabase (optional: persistence) ────────────────────────────────────────
# Create a free project at https://supabase.com, then run
# supabase/migrations/20261021000000_root_and_reason_schema.sql in the SQL editor.
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= 

# Server-side only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY= 
# Legacy projects only: auto-generated service_role JWT. Do not set both.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini (optional: AI chat & narrative reports) ───────────────────
# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-2.5-flash
